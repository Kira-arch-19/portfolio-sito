
@model Portfolio.Models.Project

@{
    ViewData["Title"] = Model.Name;

    var images = Model.Images
        .OrderByDescending(i => i.IsCover)
        .ThenBy(i => i.Position)
        .ToList();

    var carouselId = $"project-carousel-{Model.Id}";
}

<section class="py-5">
    <div class="container">

        <!-- TORNA INDIETRO -->
        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="progetti"
           class="text-decoration-none">
            ← Torna ai progetti
        </a>

        <!-- INTESTAZIONE -->
        <div class="mt-4 mb-5">

            <span class="text-primary fw-semibold">
                Progetto software
            </span>

            <h1 class="display-5 fw-bold mt-2">
                @Model.Name
            </h1>

            <p class="lead text-secondary mt-3">
                @Model.ShortDescription
            </p>

        </div>

        <!-- CAROSELLO -->
        @if (images.Count > 0)
        {
            <div class="mb-5">

                <div id="@carouselId"
                     class="carousel carousel-dark slide">

                    <div class="carousel-inner rounded-4 bg-body-tertiary">

                        @for (int i = 0; i < images.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">

                                <img src="@images[i].ImageUrl"
                                     class="d-block w-100"
                                     alt="Immagine @(i + 1) del progetto @Model.Name"
                                     style="height: clamp(240px, 45vw, 480px); object-fit: contain;" />

                            </div>
                        }

                    </div>

                    @if (images.Count > 1)
                    {
                        <!-- INDICATORI -->
                        <div class="carousel-indicators">
                            @for (int i = 0; i < images.Count; i++)
                            {
                                <button type="button"
                                        data-bs-target="#@carouselId"
                                        data-bs-slide-to="@i"
                                        class="@(i == 0 ? "active" : "")"
                                        aria-label="Immagine @(i + 1)">
                                </button>
                            }
                        </div>

                        <!-- FRECCIA PRECEDENTE -->
                        <button class="carousel-control-prev"
                                type="button"
                                data-bs-target="#@carouselId"
                                data-bs-slide="prev">

                            <span class="carousel-control-prev-icon"
                                  aria-hidden="true"></span>

                            <span class="visually-hidden">
                                Precedente
                            </span>
                        </button>

                        <!-- FRECCIA SUCCESSIVA -->
                        <button class="carousel-control-next"
                                type="button"
                                data-bs-target="#@carouselId"
                                data-bs-slide="next">

                            <span class="carousel-control-next-icon"
                                  aria-hidden="true"></span>

                            <span class="visually-hidden">
                                Successiva
                            </span>
                        </button>
                    }

                </div>

                <p class="small text-secondary text-center mt-3">
                    Galleria immagini del progetto
                </p>

            </div>
        }

        <!-- DETTAGLI -->
        <div class="row g-5">

            <div class="col-lg-8">

                <h2 class="h4 fw-bold mb-3">
                    Descrizione
                </h2>

                <p class="text-secondary"
                   style="white-space: pre-line;">@Model.Description</p>

                @if (!string.IsNullOrWhiteSpace(Model.GithubLink))
                {
                    <a href="@Model.GithubLink"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-primary mt-3">
                        Visualizza repository GitHub
                    </a>
                }

            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">

                        <h3 class="h5 fw-bold">
                            Informazioni
                        </h3>

                        <h4 class="h6 mt-4">
                            Tecnologie utilizzate
                        </h4>

                        <p class="text-secondary">
                            @Model.Technologies
                        </p>

                        <h4 class="h6 mt-4">
                            Competenze sviluppate
                        </h4>

                        <p class="text-secondary">
                            @Model.SkillImproved
                        </p>

                    </div>
                </div>

            </div>

        </div>

    </div>
</section>
