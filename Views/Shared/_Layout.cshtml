<!DOCTYPE html>
<html lang="it">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Portfolio</title>

    <script type="importmap"></script>

    <!-- BOOTSTRAP -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS GLOBALE -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />
    <!-- CSS ISOLATION -->
    <link rel="stylesheet"
          href="~/Portfolio.styles.css"
          asp-append-version="true" />

</head>

<body>

    <!-- =====================================
         HEADER
         ===================================== -->

    <header class="sticky-top">

        <nav class="navbar navbar-expand-lg portfolio-navbar">

            <div class="container">

                <!-- LOGO -->

                <a class="navbar-brand portfolio-brand d-flex flex-nowrap align-items-center"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-text">

                        <span class="brand-name">
                            Matteo
                        </span>

                        <span class="brand-role">
                            Portfolio
                        </span>

                    </span>

                </a>


                <!-- PULSANTE MENU MOBILE -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#portfolioNavbar"
                        aria-controls="portfolioNavbar"
                        aria-expanded="false"
                        aria-label="Apri menu di navigazione">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- MENU DI NAVIGAZIONE -->

                <div class="collapse navbar-collapse"
                     id="portfolioNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-4">

                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <!-- PROGETTI -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="progetti">

                                Progetti

                            </a>

                        </li>


                        <!-- Contatti -->
<li class="nav-item">
    <a class="nav-link"
       asp-controller="Home"
       asp-action="Index"
       asp-fragment="contatti">
        Contatti
    </a>
</li>


                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- =====================================
         CONTENUTO DELLA PAGINA
         ===================================== -->

    <main role="main" class="container pb-3">

        @RenderBody()

    </main>


    <!-- =====================================
         FOOTER
         ===================================== -->

    <footer class="footer text-muted">
    <div class="container text-center">
        &copy; @DateTime.Now.Year Portfolio Progetti.
        All rights reserved.
        <br />
        Designed & Developed by
        <strong>Matteo Porrini Cattò</strong>
    </div>
</footer>


    <!-- =====================================
         JAVASCRIPT
         ===================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>