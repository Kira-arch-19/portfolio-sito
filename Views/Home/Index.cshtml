
@model List<Portfolio.Models.Project>

@{
    ViewData["Title"] = "Home";
}

<section class="py-5 text-center">
    <div class="container">
        <p class="text-primary fw-semibold">
            Junior Software Developer
        </p>

        <h1 class="display-4 fw-bold">
            Ciao, sono Matteo.
        </h1>

        <p class="lead text-secondary mt-3">
            Sviluppo applicazioni software,
            backend e API REST utilizzando
            C#, Java e tecnologie moderne.
        </p>

        <a href="#progetti" class="btn btn-primary mt-3">
            Scopri i miei progetti
        </a>
    </div>
</section>

<section id="progetti" class="py-5">
    <div class="container">

        <h2 class="fw-bold mb-4">
            I miei progetti
        </h2>

        @if (Model.Count == 0)
        {
            <p class="text-secondary">
                Nessun progetto disponibile.
            </p>
        }
        else
        {
            <div class="row g-4">

                @foreach (var project in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column">

                                <h3 class="h5 card-title">
                                    @project.Name
                                </h3>

                                <p class="card-text text-secondary">
                                    @project.ShortDescription
                                </p>

                                <p class="small">
                                    <strong>Tecnologie:</strong>
                                    @project.Technologies
                                </p>

                                @if (!string.IsNullOrWhiteSpace(project.GithubLink))
                                {
                                    <a href="@project.GithubLink"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-outline-primary mt-auto">
                                        Visualizza su GitHub
                                    </a>
                                }

                            </div>
                        </div>
                    </div>
                }

            </div>
        }

    </div>
</section>
